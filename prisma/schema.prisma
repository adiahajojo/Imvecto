generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth tables, used by NextAuth for email magic link login ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core Imvecto tables ---

enum Role {
  DONOR
  ORG
  VERIFIER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  walletAddress String?   @unique
  role          Role      @default(DONOR)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  projects      Project[]     @relation("ProjectOwner")
  contributions Contribution[]
  agentActions  AgentAction[]
}

enum ProjectCategory {
  CARE
  BUILD
  INFRASTRUCTURE
}

enum ProjectStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  FUNDED
  COMPLETED
}

model Project {
  id                    String          @id @default(cuid())
  title                 String
  description           String
  category              ProjectCategory
  location              String
  ownerId               String
  targetAmount          Float
  raisedAmount          Float           @default(0)
  status                ProjectStatus   @default(DRAFT)
  tokenSymbol           String @unique
  tokenType             String          @default("RWA_TOKEN")
  brickkenTokenAddress  String?
  createdAt             DateTime        @default(now())

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  milestones    Milestone[]
  contributions Contribution[]
  impactMetrics ImpactMetric[]
  transactions  Transaction[]
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  evidenceUrl String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Contribution {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  amount      Float
  tokenSymbol String
  txHash      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model ImpactMetric {
  id           String   @id @default(cuid())
  projectId    String
  metricName   String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String   @id @default(cuid())
  projectId     String
  userId        String?
  brickkenTxId  String?
  txHash        String?
  method        String
  chainId       String
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model AgentAction {
  id                    String   @id @default(cuid())
  userId                String
  action                String
  projectId             String?
  status                String   @default("pending")
  confirmationRequired  Boolean  @default(true)
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
