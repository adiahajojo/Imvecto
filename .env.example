# Database
DATABASE_URL="postgresql://user:password@localhost:5432/imvecto"

# NextAuth
NEXTAUTH_SECRET="generate a random string for this"
NEXTAUTH_URL="http://localhost:3000"

# Email magic link, use a provider like Resend or Mailtrap for local testing
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Imvecto <no-reply@imvecto.app>"

# WalletConnect, get a free project id from cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your project id"

# Brickken, server side only, never expose this to the frontend
BRICKKEN_API_KEY="your sandbox api key"
BRICKKEN_SIGNER_ADDRESS="your whitelisted project owner wallet"
